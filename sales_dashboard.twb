      <column caption='MonthStart' datatype='date' name='[Calculation_705657825159688192]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='MAKEDATE(YEAR([ORDERDATE]), MONTH([ORDERDATE]), 1)' />
      </column>
      <column caption='Deals' datatype='integer' name='[Calculation_705657825160159233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([ORDERNUMBER])' />
      </column>
      <column caption='Avg Deal Size' datatype='real' name='[Calculation_705657825160261634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([SALES]) / COUNTD([ORDERNUMBER])' />
      </column>
      <column caption='Profit' datatype='real' name='[Calculation_705657825160454147]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([SALES]) - 0' />
      </column>
      <column caption='Profit Margin %' datatype='real' name='[Calculation_705657825160531972]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([SALES]) = 0 THEN 0&#13;&#10;ELSE [Calculation_705657825160454147] / SUM([SALES])&#13;&#10;END' />
      </column>
      <column caption='Zero' datatype='integer' name='[Calculation_705657825191100424]' role='measure' type='quantitative'>
